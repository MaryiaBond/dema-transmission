    "jsdom": "^27.0.1",
    "typescript": "~5.9.3",
    "vite": "^7.1.9",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.1.1"
